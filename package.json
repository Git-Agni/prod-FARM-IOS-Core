{
  "name": "@git-agni/phone-farm-core",
  "version": "0.1.0-review.0",
  "private": false,
  "description": "Standalone iOS device farm with registration, streaming, scheduling, plugins, and TikTok automation",
  "files": [
    "src",
    "static",
    "Patches",
    "drizzle",
    "docker-compose.yml",
    "README.md",
    "PLUGIN_DEVELOPMENT.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tiktok": "./src/tiktok-plugin.ts",
    "./example-plugin": "./src/example-plugin.ts",
    "./server": "./src/api/server.ts",
    "./worker": "./src/scheduler/worker.ts"
  },
  "scripts": {
    "appium": "APPIUM_HOME=.appium2 appium --base-path / --port 4725 --log-level info",
    "appium:install-driver": "APPIUM_HOME=.appium2 appium driver install xcuitest@7.26.3",
    "wda:prepare": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/devices/wda/prepare.ts",
    "wda:service": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/devices/wda-service.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/database/migrate.ts",
    "db:setup": "node --env-file-if-exists=.env --import tsx src/database/setup.ts",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/scheduler/worker.ts",
    "web": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/api/server.ts",
    "build:web": "tsc -p tsconfig.web.json",
    "preweb": "npm run build:web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "appium-ios-device": "^3.1.21",
    "cron-parser": "^5.10.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "htmx.org": "^2.0.8",
    "node-native-ocr": "^0.4.18",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "sharp": "^0.35.3",
    "webdriverio": "9.31.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "appium": "^3.7.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "node-native-ocr@0.4.18": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "appium": false,
    "core-js": false,
    "edgedriver": false,
    "geckodriver": false,
    "fsevents": false
  }
}
