+static BOOL FBWaitForPhotoLibraryAuthorization(NSError **error)
+{
+  __block PHAuthorizationStatus status = [PHPhotoLibrary authorizationStatusForAccessLevel:PHAccessLevelAddOnly];
+  if (PHAuthorizationStatusNotDetermined == status) {
+    dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+    [PHPhotoLibrary requestAuthorizationForAccessLevel:PHAccessLevelAddOnly handler:^(PHAuthorizationStatus newStatus) {
+      status = newStatus;
+      dispatch_semaphore_signal(semaphore);
+    }];
+    if (0 != dispatch_semaphore_wait(semaphore, dispatch_time(DISPATCH_TIME_NOW, (int64_t)(60 * NSEC_PER_SEC)))) {
+      *error = [NSError errorWithDomain:@"com.facebook.WebDriverAgent" code:2
+                               userInfo:@{NSLocalizedDescriptionKey: @"Timed out waiting for Photos permission"}];
+      return NO;
+    }
+  }
+  if (PHAuthorizationStatusAuthorized != status && PHAuthorizationStatusLimited != status) {
+    *error = [NSError errorWithDomain:@"com.facebook.WebDriverAgent" code:3
+                             userInfo:@{NSLocalizedDescriptionKey: @"Photos access is denied. Allow access for WebDriverAgentRunner in iOS Settings."}];
+    return NO;
+  }
+  return YES;
+}
