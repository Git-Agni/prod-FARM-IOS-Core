+static NSString *FBImportMedia(NSString *name, NSString *mimeType, NSString *base64Data, NSError **error)
+{
+  if (0 == name.length || 0 == base64Data.length || 0 == mimeType.length) {
+    *error = [NSError errorWithDomain:@"com.facebook.WebDriverAgent" code:4
+                             userInfo:@{NSLocalizedDescriptionKey: @"name, mimeType, and base64 data are required"}];
+    return nil;
+  }
+  NSData *data = [[NSData alloc] initWithBase64EncodedString:base64Data options:0];
+  if (nil == data) {
+    *error = [NSError errorWithDomain:@"com.facebook.WebDriverAgent" code:5
+                             userInfo:@{NSLocalizedDescriptionKey: @"Media data is not valid base64"}];
+    return nil;
+  }
+  if (!FBWaitForPhotoLibraryAuthorization(error)) {
+    return nil;
+  }
+  NSString *safeName = [name lastPathComponent];
+  NSURL *fileURL = [NSURL fileURLWithPath:[NSTemporaryDirectory() stringByAppendingPathComponent:
+                                           [NSString stringWithFormat:@"%@-%@", NSUUID.UUID.UUIDString, safeName]]];
+  if (![data writeToURL:fileURL options:NSDataWritingAtomic error:error]) {
+    return nil;
+  }
+  __block NSString *identifier = nil;
+  __block BOOL succeeded = NO;
+  __block NSError *changeError = nil;
+  dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+  [[PHPhotoLibrary sharedPhotoLibrary] performChanges:^{
+    PHAssetChangeRequest *request = [mimeType hasPrefix:@"video/"]
+      ? [PHAssetChangeRequest creationRequestForAssetFromVideoAtFileURL:fileURL]
+      : [PHAssetChangeRequest creationRequestForAssetFromImageAtFileURL:fileURL];
+    identifier = request.placeholderForCreatedAsset.localIdentifier;
+  } completionHandler:^(BOOL success, NSError *operationError) {
+    succeeded = success;
+    changeError = operationError;
+    dispatch_semaphore_signal(semaphore);
+  }];
+  long waitResult = dispatch_semaphore_wait(semaphore, dispatch_time(DISPATCH_TIME_NOW, (int64_t)(120 * NSEC_PER_SEC)));
+  [[NSFileManager defaultManager] removeItemAtURL:fileURL error:nil];
+  if (0 != waitResult || !succeeded) {
+    *error = changeError ?: [NSError errorWithDomain:@"com.facebook.WebDriverAgent" code:6
+                                            userInfo:@{NSLocalizedDescriptionKey: @"Timed out importing media into Photos"}];
+    return nil;
+  }
+  return identifier;
+}
