{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "rootDir": "static/dashboard/ts",
    "outDir": "static/dashboard/assets",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["static/dashboard/ts/**/*.ts"]
}
